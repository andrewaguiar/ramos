module File
  # @module_doc
  #
  # File — reading, writing, and managing files on the host filesystem.
  #
  # This is Ramos's window onto mutable state: files change over time. Every
  # function here is therefore *effectful* and reports success or failure as a
  # value you pattern match, never by raising:
  #
  #   - fallible operations return `(:ok, value)`, or an error built by `error`
  #   - operations with nothing to hand back return the bare `:ok`
  #   - `exists` and `is_file` return a plain `true`/`false`
  #
  # A failure is `(:error, (reason, message, stacktrace))`. `reason` is a
  # lowercase symbol straight from the OS — `:enoent` (no such file), `:eacces`
  # (permission denied), `:eexist`, `:io_error`, or `:unsupported` — the same
  # vocabulary a bare reason would use, but a symbol alone does not say *which*
  # path failed, so `message` names both: `"reading file \`config.txt\` failed
  # with :enoent"`. Branches read cleanly:
  #
  #   case File.read("config.txt")
  #     (:ok, text) -> parse(text)
  #     (:error, (:enoent, _, _)) -> :use_defaults
  #     (:error, (reason, message, _)) -> (:error, (:config_unreadable, message))
  #
  # Every function takes a path; there are no open file handles. `read` and
  # `write` move the whole file at once, which keeps the model simple and the
  # values immutable.
  #
  # Conventions:
  #   - paths are host-native strings; relative paths resolve against the cwd.
  #   - `write` truncates; `append` adds to the end; both create the file if it
  #     is missing.
  #   - `mv` is the one way to move a file: it tries a rename first and falls
  #     back to copy + delete, so it works across filesystems.

  function read(path)
    # @doc
    #
    # Reads the entire file at `path` into a string.
    #
    # @param path: the path to read
    # @return `(:ok, contents)`, or an error built by `error` if it cannot be
    #   read
    #
    #   File.write("greeting.txt", "hello\n")
    #   File.read("greeting.txt")   # == (:ok, "hello\n")
    #   (:error, (type, message, _)) = File.read("missing.txt")
    #   (type, message)   # == (:enoent, "reading file `missing.txt` failed with :enoent")
    wrap(native("file_read", [path]), "reading file `#{path}`")

  function write(path, contents)
    # @doc
    #
    # Writes `contents` to `path`, replacing any existing content and creating
    # the file if it does not exist.
    #
    # @param path: the path to write
    # @param contents: the string to write
    # @return `:ok`, or an error built by `error` on failure
    #
    #   File.write("out.txt", "hello\n")   # == :ok
    wrap(native("file_write", [path, contents]), "writing file `#{path}`")

  function append(path, contents)
    # @doc
    #
    # Appends `contents` to the end of `path`, creating the file if it does not
    # exist. Unlike `write`, existing content is preserved.
    #
    # @param path: the path to append to
    # @param contents: the string to append
    # @return `:ok`, or an error built by `error` on failure
    #
    #   File.append("log.txt", "another line\n")   # == :ok
    wrap(native("file_append", [path, contents]), "appending to file `#{path}`")

  function size(path)
    # @doc
    #
    # Returns the size of `path` in bytes.
    #
    # @param path: the path to measure
    # @return `(:ok, bytes)`, or an error built by `error` if it cannot be read
    #
    #   File.write("greeting.txt", "hello\n")
    #   File.size("greeting.txt")   # == (:ok, 6)
    wrap(native("file_size", [path]), "reading size of file `#{path}`")

  function rm(path)
    # @doc
    #
    # Deletes the file at `path`.
    #
    # @param path: the path to delete
    # @return `:ok`, or an error built by `error` (e.g. `:enoent` if it is not
    #   there)
    #
    #   File.write("out.txt", "bye\n")
    #   File.rm("out.txt")   # == :ok
    wrap(native("file_remove", [path]), "removing file `#{path}`")

  function cp(source, dest)
    # @doc
    #
    # Copies the file at `source` to `dest`, overwriting `dest` if it exists.
    #
    # @param source: the file to copy from
    # @param dest: the path to copy to
    # @return `:ok`, or an error built by `error` on failure
    #
    #   File.write("a.txt", "hello\n")
    #   File.cp("a.txt", "b.txt")   # == :ok
    wrap(native("file_copy", [source, dest]), "copying file `#{source}` to `#{dest}`")

  function mv(source, dest)
    # @doc
    #
    # Moves the file at `source` to `dest`. Works across filesystems: it tries a
    # rename first, then falls back to a copy followed by deleting `source`.
    #
    # @param source: the file to move from
    # @param dest: the path to move to
    # @return `:ok`, or an error built by `error` on failure
    #
    #   File.write("draft.txt", "hello\n")
    #   File.mv("draft.txt", "final.txt")   # == :ok
    wrap(native("file_move", [source, dest]), "moving file `#{source}` to `#{dest}`")

  function exists(path)
    # @doc
    #
    # Returns `true` if something exists at `path` (a file or a directory), else
    # `false`. Use `is_file` to require that it is a regular file.
    #
    # @param path: the path to test
    # @return `true` if `path` exists, else `false`
    #
    #   File.write("out.txt", "hello\n")
    #   File.exists("out.txt")   # == true
    #   File.exists("missing")   # == false
    native("path_exists", [path])

  function is_file(path)
    # @doc
    #
    # Returns `true` if `path` exists and is a regular file, else `false`
    # (including when `path` is a directory or does not exist).
    #
    # @param path: the path to test
    # @return `true` if `path` is a regular file, else `false`
    #
    #   File.write("out.txt", "hello\n")
    #   Dir.mkdir("src")
    #   File.is_file("out.txt")   # == true
    #   File.is_file("src")       # == false
    native("path_is_file", [path])

  function touch(path)
    # @doc
    #
    # Creates `path` if it does not exist, and updates its modified time to now.
    # Existing content is preserved — the file-manager equivalent of `touch(1)`.
    #
    # @param path: the path to touch
    # @return `:ok`, or an error built by `error` on failure
    #
    #   File.touch("build.stamp")   # == :ok
    wrap(native("file_touch", [path]), "touching file `#{path}`")

  function chmod(path, mode)
    # @doc
    #
    # Sets the permission bits of `path`. `mode` is the numeric permission — for
    # example `493` is `rwxr-xr-x` and `420` is `rw-r--r--`.
    #
    # @param path: the path to change
    # @param mode: the numeric permission bits
    # @return `:ok`, an error built by `error`, or an `:unsupported` error off
    #   Unix
    #
    #   File.write("run.sh", "echo hi\n")
    #   File.chmod("run.sh", 493)   # == :ok
    wrap(native("file_chmod", [path, mode]), "changing permissions of file `#{path}`")

  # private functions

  helper wrap(result, action)
    # @doc
    #
    # (private) Turns a native `(:error, reason)` into an error built by
    # `error`: the reason stays the same symbol, but the message names the
    # path `action` describes together with it, since a bare `:enoent` alone
    # does not say which file failed. Anything else — `:ok`, or `(:ok, value)`
    # — passes through unchanged.
    case result
      (:error, reason) -> error(reason, "#{action} failed with #{reason}")
      value -> value
