struct Time
  # @module_doc
  #
  # Time — a time of day: `hour`/`minute`/`second`/`millisecond`, with no
  # date and no time zone.
  #
  #   t = Time.new(13, 45, 30)
  #   t.hour     # == 13
  #   t.minute   # == 45
  #
  # There is no day to carry into, so every field wraps at its own boundary
  # instead of normalizing into the next one the way `Date`'s `day` does —
  # `add_hours` past `23` wraps back to `0`. `add_*` takes `self` first, so it
  # pipes the same way any other `self`-taking function does:
  #
  #   Time{hour: 23}
  #   | .add_hours(2)
  #   # == Time{hour: 1, minute: 0, second: 0, millisecond: 0}
  #
  # Conventions:
  #   - `compare` follows `Integer.compare`: `-1`, `0`, `1`.
  #   - `to_iso`/`parse` round-trip through `"HH:MM:SS.mmm"`; `parse` also
  #     accepts a bare `"HH:MM:SS"` (millisecond `0`) and a fractional part of
  #     any precision (`"HH:MM:SS.5"` is 500ms, `"HH:MM:SS.123456"` truncates
  #     to `123`ms) — this is also what the `T"..."` sigil parses.
  #   - see `NaiveDateTime` for this paired with a calendar date.

  attributes
    hour: 0
    minute: 0
    second: 0
    millisecond: 0

  function new(hour, minute, second)
    # @doc
    #
    # Builds a `Time` with `millisecond: 0`. Every field wraps at its own
    # boundary rather than raising — `hour: 24` is `0`, `hour: -1` is `23`.
    #
    # @param hour: the hour; wraps modulo 24
    # @param minute: the minute; wraps modulo 60
    # @param second: the second; wraps modulo 60
    # @return a new `Time`
    #
    #   Time.new(13, 45, 30)   # == Time{hour: 13, minute: 45, second: 30, millisecond: 0}
    #   Time.new(24, 0, 0)     # == Time{hour: 0, minute: 0, second: 0, millisecond: 0}
    #   Time.new(-1, 0, 0)     # == Time{hour: 23, minute: 0, second: 0, millisecond: 0}
    from_millis_of_day(raw_millis(hour, minute, second, 0))

  function now()
    # @doc
    #
    # The current time of day, read from the wall clock as UTC.
    #
    # @return the current `Time`
    #
    #   Time.now().hour < 24   # == true
    from_millis_of_day(Kernel.now() % 86400000)

  function from_millis_of_day(ms)
    # @doc
    #
    # The `Time` that is `ms` milliseconds after midnight, wrapping at a day
    # (`86400000` ms) either direction.
    #
    # @param ms: milliseconds since midnight, as an `Integer`; any value wraps
    # @return the corresponding `Time`
    #
    #   Time.from_millis_of_day(0)        # == Time{hour: 0, minute: 0, second: 0, millisecond: 0}
    #   Time.from_millis_of_day(-1)       # == Time{hour: 23, minute: 59, second: 59, millisecond: 999}
    #   Time.from_millis_of_day(86400000) # == Time{hour: 0, minute: 0, second: 0, millisecond: 0}
    from_millis_of_day_raw(ms)

  helper from_millis_of_day_raw(ms)
    # @doc
    #
    # (private) `from_millis_of_day`'s own body, so `shift` can reach it
    # without calling the public function.
    normalized = ms % 86400000
    Time{
      hour: normalized / 3600000,
      minute: (normalized / 60000) % 60,
      second: (normalized / 1000) % 60,
      millisecond: normalized % 1000
    }

  function parse(text)
    # @doc
    #
    # Parses `"HH:MM:SS"` or `"HH:MM:SS.fraction"`, `fraction` any number of
    # digits (padded or truncated to milliseconds) — the shape `to_iso`
    # renders, and what the `T"..."` sigil uses.
    #
    # @param text: a time of day in that form
    # @return the corresponding `Time`
    #
    #   Time.parse("13:45:30")       # == Time{hour: 13, minute: 45, second: 30, millisecond: 0}
    #   Time.parse("13:45:30.5")     # == Time{hour: 13, minute: 45, second: 30, millisecond: 500}
    #   Time.parse("13:45:30.123456")
    #   # == Time{hour: 13, minute: 45, second: 30, millisecond: 123}
    [clock, fraction] =
      if String.contains(text, ".")
        String.split(text, ".")
      else
        [text, ""]
    [h, mi, s] = String.split(clock, ":")
    from_millis_of_day(raw_millis(to_integer(h), to_integer(mi), to_integer(s), millis_from_fraction(fraction)))

  function to_millis_of_day(self)
    # @doc
    #
    # `self` as milliseconds since midnight.
    #
    # @param self: the time to convert
    # @return an `Integer` in `0`..`86399999`
    #
    #   Time.to_millis_of_day(Time{hour: 0, minute: 0, second: 1})   # == 1000
    to_millis_of_day_raw(self)

  helper to_millis_of_day_raw(self)
    # @doc
    #
    # (private) `to_millis_of_day`'s own body, so `shift` can reach it without
    # calling the public function.
    raw_millis(self.hour, self.minute, self.second, self.millisecond)

  function to_iso(self)
    # @doc
    #
    # `self` rendered as `"HH:MM:SS.mmm"`, zero-padded.
    #
    # @param self: the time to render
    # @return the ISO-8601-shaped string
    #
    #   Time.to_iso(Time{hour: 3, minute: 5, second: 9, millisecond: 7})   # == "03:05:09.007"
    "#{pad(self.hour, 2)}:#{pad(self.minute, 2)}:#{pad(self.second, 2)}.#{pad(self.millisecond, 3)}"

  function add_hours(self, n)
    # @doc
    #
    # `self` shifted by `n` hours, wrapping at a day.
    #
    # @param self: the starting time
    # @param n: how many hours to add (negative subtracts)
    # @return a new `Time`
    #
    #   Time.add_hours(Time{hour: 23}, 2)   # == Time{hour: 1, minute: 0, second: 0, millisecond: 0}
    shift(self, n * 3600000)

  function add_minutes(self, n)
    # @doc
    #
    # `self` shifted by `n` minutes, wrapping at a day.
    #
    # @param self: the starting time
    # @param n: how many minutes to add (negative subtracts)
    # @return a new `Time`
    #
    #   Time.add_minutes(Time{hour: 0, minute: 30}, 45)   # == Time{hour: 1, minute: 15, second: 0, millisecond: 0}
    shift(self, n * 60000)

  function add_seconds(self, n)
    # @doc
    #
    # `self` shifted by `n` seconds, wrapping at a day.
    #
    # @param self: the starting time
    # @param n: how many seconds to add (negative subtracts)
    # @return a new `Time`
    #
    #   Time.add_seconds(Time{second: 45}, 30)   # == Time{hour: 0, minute: 1, second: 15, millisecond: 0}
    shift(self, n * 1000)

  function compare(self, other)
    # @doc
    #
    # Orders two times as `-1`, `0` or `1` — the shape `Integer.compare` uses,
    # since there is no built-in `<`/`>` for structs.
    #
    # @param self: the first time
    # @param other: the second time
    # @return `-1` when `self` is earlier, `1` when later, `0` when equal
    #
    #   Time.compare(Time{hour: 1}, Time{hour: 2})   # == -1
    #   Time.compare(Time{hour: 2}, Time{hour: 1})   # == 1
    #   Time.compare(Time{hour: 1}, Time{hour: 1})   # == 0
    Integer.compare(to_millis_of_day(self), to_millis_of_day(other))

  function diff_millis(self, other)
    # @doc
    #
    # The number of milliseconds from `other` to `self` — positive when
    # `self` is later, negative when earlier. Both are read as times on the
    # same day, so this does not wrap.
    #
    # @param self: the later (or earlier) time
    # @param other: the time to measure from
    # @return an `Integer` millisecond count
    #
    #   Time.diff_millis(Time{second: 10}, Time{second: 1})   # == 9000
    to_millis_of_day(self) - to_millis_of_day(other)

  helper raw_millis(hour, minute, second, millisecond)
    # @doc
    #
    # (private) Milliseconds since midnight for the given fields, unwrapped —
    # shared arithmetic behind `new`, `parse` and `to_millis_of_day`.
    hour * 3600000 + minute * 60000 + second * 1000 + millisecond

  helper shift(self, millis)
    # @doc
    #
    # (private) `self` moved by `millis` milliseconds, wrapping at a day.
    # Backs the `add_*` family.
    from_millis_of_day_raw(to_millis_of_day_raw(self) + millis)

  helper millis_from_fraction(digits)
    # @doc
    #
    # (private) A fractional-second string of any length as milliseconds:
    # `"5"` is `500`, `"123456"` truncates to `123`. Backs `parse`.
    if digits == ""
      0
    else
      to_integer(String.slice(String.pad_right(digits, 3, "0"), 0, 3))

  helper pad(n, width)
    # @doc
    #
    # (private) `n` rendered as decimal digits, left-padded with zeros to at
    # least `width` characters. Backs `to_iso`.
    String.pad_left(to_string(n), width, "0")
