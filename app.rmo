# app.rmo
module App
  function main()
    game_loop(
      [
        (10, 10),
        (9, 10),
        (8, 10)
      ],
      5,
      5,
      "RIGHT",
      0
    )
    

function game_loop(snake, food_x, food_y, direction, tick)

  direction = read_direction(direction)
  if tick >= 5
    move_cursor(0, 0)
    clear()

    print_board(
      snake,
      food_x,
      food_y,
      direction
    )

    new_snake = move_snake(
      snake,
      direction
    )

    if ate_food(new_snake, food_x, food_y)
      game_loop(
        grow_snake(new_snake),
        10,
        10,
        direction,
        0
      )

    else
      game_loop(
        new_snake,
        food_x,
        food_y,
        direction,
        0
      )
    end

  else

    sleep(50)

    game_loop(
      snake,
      food_x,
      food_y,
      direction,
      tick + 1
    )

  end


function move_snake(snake, direction)

  head = at(snake, 0)

  head_x = at(head, 0)
  head_y = at(head, 1)

  new_head = (
    move_x(head_x, direction),
    move_y(head_y, direction)
  )

  [
    new_head,
    at(snake, 0),
    at(snake, 1)
  ]


function update_direction(direction, key)

  if key == "RIGHT"
    "RIGHT"
  else
    if key == "LEFT"
      "LEFT"
    else
      if key == "UP"
        "UP"
      else
        if key == "DOWN"
          "DOWN"
        else
          direction
        end
      end
    end
  end

function print_board(snake, food_x, food_y, direction)
  print_row(
    0,
    snake,
    food_x,
    food_y
  )


function grow_snake(snake)

  [
    at(snake, 0),
    at(snake, 1),
    at(snake, 2),
    at(snake, 2)
  ]



function print_row(row, snake, food_x, food_y)

  if row >= 20
    print("██████████████████████\n")
  else
    print("█")

    print_cells(
      0,
      row,
      snake,
      food_x,
      food_y
    )

    print("█\n")

    print_row(
      row + 1,
      snake,
      food_x,
      food_y
    )
  end


function print_cells(col, row, snake, food_x, food_y)

  if col >= 20
    ""
  else

    if snake_contains(snake, col, row)
      print("O")
    else
      if col == food_x and row == food_y
        print("*")
      else
        print(" ")
      end
    end

    print_cells(
      col + 1,
      row,
      snake,
      food_x,
      food_y
    )
  end

function snake_contains(snake, x, y)

  part = at(snake, 0)

  if at(part, 0) == x and at(part, 1) == y
    true
  else
    part = at(snake, 1)

    if at(part, 0) == x and at(part, 1) == y
      true
    else
      false
    end
  end


function move_x(x, direction)

  if direction == "RIGHT"
    x + 1
  else
    if direction == "LEFT"
      x - 1
    else
      x
    end
  end


function move_y(y, direction)

  if direction == "DOWN"
    y + 1
  else
    if direction == "UP"
      y - 1
    else
      y
    end
  end

function read_direction(direction)

  if has_key()
    key = read_key()
    update_direction(direction, key)
  else
    direction
  end


function ate_food(snake, food_x, food_y)

  head = at(snake, 0)

  x = at(head, 0)
  y = at(head, 1)

  x == food_x and y == food_y