# trait.rmo — a trait declares a contract of functions. A function *with* a
# body is a default implementation; a function *without* one is required, and
# every implementer must define it.

trait Helloable
  function hello(self)
    print("Ola #{self.name}, eu tenho #{self.age}")

  function describe(self)
    "#{self.name} (#{self.age})"

  function is_over_eighteen(self)   # required, no body
