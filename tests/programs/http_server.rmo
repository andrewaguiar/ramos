# HttpServer: bind a real port, serve one request through a handler lambda,
# and read the response back over a real Socket connection.
function first_line(request)
  case String.find(request, "\r\n")
    nil -> request
    i -> String.slice(request, 0, i)

function connect_when_ready(port, attempts)
  case Socket.connect("127.0.0.1", port)
    (:ok, socket) -> (:ok, socket)
    (:error, reason) when attempts <= 0 -> (:error, reason)
    (:error, _) ->
      sleep(10)
      connect_when_ready(port, attempts - 1)

# `HttpResponse.send_chunk` writes the headers and each chunk as its own
# `Socket.send`, so the response may arrive as more than one `recv` — read
# until the server closes the connection (which it does right after the
# handler returns) rather than assuming one `recv` gets everything.
function read_all(socket, acc)
  case Socket.recv(socket, 1024)
    (:ok, "") -> acc
    (:ok, chunk) -> read_all(socket, acc <> chunk)

# Reserve a free port with a throwaway bind, then hand the number to the
# server — avoids hardcoding a port that might already be taken.
(:ok, probe) = ServerSocket.bind("127.0.0.1", 0)
(:ok, port) = ServerSocket.local_port(probe)
ServerSocket.close(probe)

handler =
  do request, socket
    body = "you said: #{first_line(request)}"
    HttpResponse.new(socket)
    | HttpResponse.put_header("Content-Length", "#{String.length(body)}")
    | HttpResponse.send_chunk(body)

Thread.start(do -> HttpServer{port: port}.start(handler))

(:ok, socket) = connect_when_ready(port, 50)
Socket.send(socket, "GET /hello HTTP/1.1\r\nHost: localhost\r\n\r\n")
response = read_all(socket, "")
Socket.close(socket)
println(response)

# The server thread never returns (its accept loop runs forever) — end the
# whole process rather than waiting for it.
exit(0)
